<?xml version="1.0" encoding="utf-8"?>
<!-- The app is native code: InkActivity (a NativeActivity that also hands touch and key input to the native side)
     loads libink_android.so and calls android_main. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="app.inkwell"
    android:versionCode="2"
    android:versionName="1.1.0-beta">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35" />
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="true" />

    <application
        android:label="inkwell"
        android:icon="@mipmap/ic_launcher"
        android:hasCode="true"
        android:extractNativeLibs="true"
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="false"
        android:theme="@style/AppTheme">

        <activity
            android:name="app.inkwell.InkActivity"
            android:label="inkwell"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|screenLayout|uiMode|density|navigation">
            <meta-data android:name="android.app.lib_name" android:value="ink_android" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
